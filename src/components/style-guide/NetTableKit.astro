---
import { LATEST_SUPPORTED_YEAR } from "@/data/index.ts";
import { amountPage } from "@/islands/netTable/model.ts";
import { loadResidences } from "@/islands/netTable/residences.ts";
import { NetTableSpecimens } from "./kit/NetTableSpecimens.tsx";
import Section from "./Section.astro";

const SHOWN = new Set(["lombardia", "lazio", "campania", "bolzano"]);
const page = amountPage(30_000, LATEST_SUPPORTED_YEAR, await loadResidences(LATEST_SUPPORTED_YEAR));
const cities = page.cities.filter((city) => SHOWN.has(city.residence.region));
---

<Section id="lordo-netto">
  <p class="qg-lede" slot="intro">
    I componenti della tabella lordo netto e delle pagine per importo, in
    <code class="sg-code">src/islands/netTable</code>: pagine di testo senza JavaScript, costruite
    sul calcolo vero.
  </p>
  <NetTableSpecimens cities={cities} />
</Section>
