---
import type { Crumb } from "@/components/chrome/navigation.ts";
import type { Locale } from "@/i18n/locales.ts";
import { getT } from "@/i18n/messages/index.ts";

interface Props {
  readonly locale: Locale;
  readonly crumbs: readonly Crumb[];
}

const { locale, crumbs } = Astro.props;
const t = getT(locale, "layout");
---

{crumbs.length > 0 && (
  <nav class="qg-breadcrumbs" aria-label={t("breadcrumbs.label")}>
    <ol class="qg-breadcrumbs__list" role="list">
      {crumbs.map((crumb) => (
        <li class="qg-breadcrumbs__item">
          <a class="qg-breadcrumbs__link" href={crumb.href}>
            {crumb.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
